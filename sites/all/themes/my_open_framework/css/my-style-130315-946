	}

	.flex-caption, .flex-control-nav li a, .flexslider .flex-direction-nav a {
		display: none !important;
	}

	#main-nav ul.menu > li, .footer-menu ul.menu > li {
		width: 50%;
		border-left: none;
		padding-top: 20px;
	}

	.navbar .nav > li > a, .footer-menu ul.menu > li > a {
	    color: #fff;
	    float: none;
	    border-top: 3px solid #ffffff;
		border-bottom: 3px solid #ffffff;
